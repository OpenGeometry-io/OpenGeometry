{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "almond",
  "colors": {
    "primary": "#4460FF",
    "light": "#7C8FFF",
    "dark": "#2A44D6"
  },
  "contextual": {
    "options": ["copy", "view", "chatgpt", "claude", "perplexity", "mcp", "cursor", "vscode"]
  },
  "metadata": {
    "timestamp": true
  },
  "name": "OpenGeometry",
  "description": "OpenGeometry is an open-source CAD kernel for the browser: B-rep solids, booleans, extrude, sweep, revolve and STEP export, in Rust and WebAssembly with a TypeScript SDK for Three.js.",
  "seo": {
    "indexing": "navigable",
    "metatags": {
      "og:site_name": "OpenGeometry Docs",
      "og:locale": "en_US",
      "og:image": "https://docs.opengeometry.io/logo/og.png",
      "twitter:card": "summary_large_image",
      "twitter:image": "https://docs.opengeometry.io/logo/og.png",
      "twitter:site": "@openGeometry"
    }
  },
  "navigation": {
    "tabs": [
      {
        "tab": "Documentation",
        "icon": "book-open",
        "pages": [
          {
            "group": "Documentation",
            "pages": [
              {
                "group": "Get started",
                "icon": "rocket",
                "expanded": true,
                "pages": [
                  "opengeometry/what-is-opengeometry",
                  "opengeometry/installation",
                  "opengeometry/quickstart",
                  "opengeometry/agents",
                  "opengeometry/troubleshooting"
                ]
              },
              {
                "group": "Core concepts",
                "icon": "layer-group",
                "expanded": false,
                "pages": [
                  "opengeometry/concepts/architecture",
                  "opengeometry/concepts/bodies",
                  "opengeometry/concepts/coordinates-and-planes",
                  "opengeometry/concepts/display",
                  "opengeometry/concepts/history",
                  "opengeometry/concepts/errors"
                ]
              },
              {
                "group": "Guides",
                "icon": "route",
                "expanded": false,
                "pages": [
                  {
                    "group": "Make bodies",
                    "icon": "cube",
                    "expanded": true,
                    "pages": [
                      "opengeometry/guides/primitives",
                      "opengeometry/guides/extrude",
                      "opengeometry/guides/sweep",
                      "opengeometry/guides/revolve"
                    ]
                  },
                  {
                    "group": "Edit bodies",
                    "icon": "pen-ruler",
                    "expanded": false,
                    "pages": [
                      "opengeometry/guides/booleans",
                      "opengeometry/guides/shell",
                      "opengeometry/guides/rebuild-and-mirror",
                      "opengeometry/guides/transforms-and-assemblies"
                    ]
                  },
                  {
                    "group": "Read and export",
                    "icon": "file-export",
                    "expanded": false,
                    "pages": [
                      "opengeometry/guides/measure-and-validate",
                      "opengeometry/guides/picking",
                      "opengeometry/guides/export-step",
                      "opengeometry/guides/ifc-exchange-body"
                    ]
                  },
                  {
                    "group": "2D",
                    "icon": "vector-square",
                    "expanded": false,
                    "pages": ["opengeometry/guides/regions-and-offsets"]
                  },
                  {
                    "group": "Integrate",
                    "icon": "plug",
                    "expanded": false,
                    "pages": [
                      "opengeometry/guides/use-your-threejs-scene",
                      "opengeometry/guides/run-in-node"
                    ]
                  }
                ]
              },
              "opengeometry/examples",
              "opengeometry/migrate-from-2-0",
              "opengeometry/changelog"
            ]
          }
        ]
      },
      {
        "tab": "API Reference",
        "icon": "code",
        "groups": [
          {
            "group": "API Reference",
            "icon": "code",
            "pages": ["opengeometry/api/overview"]
          },
          {
            "group": "Runtime",
            "icon": "power-off",
            "expanded": false,
            "pages": [
              "opengeometry/api/opengeometry",
              "opengeometry/api/display",
              "opengeometry/api/picking"
            ]
          },

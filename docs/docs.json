          },
          {
            "group": "History",
            "icon": "clock-rotate-left",
            "expanded": false,
            "pages": ["opengeometry/api/og-mark"]
          },
          {
            "group": "Export",
            "icon": "file-export",
            "expanded": false,
            "pages": ["opengeometry/api/export"]
          },
          {
            "group": "2D",
            "icon": "vector-square",
            "expanded": false,
            "pages": ["opengeometry/api/regions", "opengeometry/api/offsets"]
          },
          {
            "group": "Errors and constants",
            "icon": "list-check",
            "expanded": false,
            "pages": ["opengeometry/api/og-error", "opengeometry/api/constants"]

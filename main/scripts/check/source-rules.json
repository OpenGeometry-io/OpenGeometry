{
  "roots": [
    { "path": ".", "recursive": true }
  ],
  "skipDirectories": ["node_modules", "target", "pkg", "dist", "examples-dist", "test-results"],
  "fileTypes": {
    "script": [".ts", ".mts", ".cts", ".js", ".mjs", ".cjs"],
    "markup": [".html"],
    "style": [".css"],
    "json": [".json", ".jsonc"]
  },
  "kebabCase": "^[a-z0-9]+(-[a-z0-9]+)*$",
  "rustRoots": [
    { "path": "opengeometry/tests", "recursive": true },
    { "path": "opengeometry/test-support", "recursive": true },
    { "path": "opengeometry/examples", "recursive": true }
  ],
  "exceptionListRoots": [
    { "path": "opengeometry/tests/source_rules", "recursive": false }
  ],
  "vendoredDirectories": [],
  "maxFileLines": 600,
  "forbiddenMentions": ["[c]laude", "[a]nthropic", "[o]pencascade", "[p]ythonocc", "\\b[o]cc\\b", "\\b[o]cp\\b"]
}
